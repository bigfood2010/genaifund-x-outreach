# Copy to .env.local and fill in. Never commit .env.local.

# X developer app (console.x.com > Apps > User authentication settings)
# Permissions: Read and write and Direct message. Type: Web App (confidential client).
# Callback URI: http://127.0.0.1:3000/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Any OpenAI-compatible chat endpoint with JSON schema output. Default is Gemini.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite

# Generate both with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# X usernames allowed to sign in and send, comma separated (the account you send from)
ALLOWED_OPERATORS=

# Test mode is on unless LIVE_SENDING=true. In test mode only these usernames can receive a DM.
TEST_RECIPIENTS=
# LIVE_SENDING=true

# Optional
# MAX_PROSPECTS_PER_RUN=10
# NO_REPLY_HOURS=72
# SENDER_DESCRIPTION=GenAI Fund builds AI ecosystems in Southeast Asia and wants meaningful conversations with relevant builders.
